    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ec.escrow_id, ec.trade_id, bool_and(dv.status = 'VERIFIED') AS docs_verified, bool_or(d.dispute_active) AS dispute_active, bool_and(ec.inspection_ok) AS inspection_ok FROM escrow_contracts ec LEFT JOIN document_verifications dv ON dv.trade_id = ec.trade_id LEFT JOIN trades d ON d.trade_id = ec.trade_id WHERE ec.tracking_number = $1 GROUP BY ec.escrow_id, ec.trade_id",
        "options": {
          "queryReplacement": "={{ $(\"Code — Normalize Status\").item.json.tracking_number }}"
        }
      },
      "id": "e4582ca1-f0d3-4be1-afbd-8dc736a05800",
