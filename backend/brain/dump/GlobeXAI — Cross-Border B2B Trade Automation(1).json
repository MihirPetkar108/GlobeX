      "name": "HTTP — Shipment Tracking API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        960
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = ($json.status || '').toLowerCase();\nlet milestone = 'UNKNOWN';\nif (raw.includes('deliver') || raw.includes('receiv')) milestone = 'RECEIVED';\nelse if (raw.includes('transit')) milestone = 'IN_TRANSIT';\nelse if (raw.includes('dispatch') || raw.includes('pickup')) milestone = 'DISPATCHED';\n\nconst events = $json.events || [];\nreturn { json: {\n  tracking_number: $json.tracking_number,\n  milestone,\n  dispatched: events.includes('dispatched'),\n  received: events.includes('received') || milestone === 'RECEIVED',\n} };"
      },
      "id": "5c792d87-2150-4afd-8201-47bdb6f6c885",
      "name": "Code — Normalize Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        960
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO shipment_events (tracking_number, milestone, dispatched, received, created_at) VALUES ($1, $2, $3, $4, NOW()) RETURNING id",
        "options": {
          "queryReplacement": "={{ $json.tracking_number }},{{ $json.milestone }},{{ $json.dispatched }},{{ $json.received }}"
        }
      },
      "id": "77c2c0f6-dde4-41de-bd57-338d32972698",
      "name": "Postgres — Save Milestone",
      "type": "n8n-nodes-base.postgres",
