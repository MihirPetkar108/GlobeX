    {
      "parameters": {
        "content": "## 3 — DOCUMENT VERIFICATION + BLOCKCHAIN\nUpload → OCR + LLM verify → compare with stored docs → IF inconsistent: alert; else SHA-256 hash → anchor on EVM TESTNET → store tx.\n**Cyan = Blockchain/Documents** · chain proves hash integrity, not physical shipment contents.",
        "height": 280,
        "width": 300,
        "color": 5
      },
      "id": "dc544429-3e35-4ab3-84d0-8c8bd43f0eab",
