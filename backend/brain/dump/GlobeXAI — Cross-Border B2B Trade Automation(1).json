        "options": {
          "queryReplacement": "={{ $json.hs_code }},{{ $json.market_opportunity_score }},{{ $json.counterparty_risk_score }},{{ $json.compliance_score }},{{ $json.final_trade_score }},{{ $json.recommendation }},{{ JSON.stringify($json.top_counterparties) }}"
        }
      },
