        "url": "<__PLACEHOLDER_VALUE__Compliance/RAG backend URL (vector DB + embeddings + LLM)__>",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"hs_code\": $(\"HTTP — HS Classifier\").item.json.hs_code, \"origin\": $(\"Edit Fields — Normalize Input\").item.json.origin_country, \"destination\": $(\"Edit Fields — Normalize Input\").item.json.destination_country, \"certifications\": $(\"Edit Fields — Normalize Input\").item.json.certifications } }}",
        "options": {}
      },
      "id": "d4c15335-4f3e-4303-8064-6b187f54c4bd",
      "name": "HTTP — Compliance RAG API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1568,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const hs = $('HTTP — HS Classifier').first().json;\nconst market = $('HTTP — Market Opportunity Model').first().json;\nconst match = $('HTTP — Counterparty Matching Model').first().json;\nconst risk = $('HTTP — Counterparty Risk Model').first().json;\nconst compliance = $('HTTP — Compliance RAG API').first().json;\n\nconst marketScore = Number(market.market_opportunity_score) || 0;\nconst riskScore = Number(risk.counterparty_risk_score) || 0;\nconst complianceScore = Number(compliance.compliance_score) || 0;\n\n// Higher market + compliance is better; higher risk is worse.\nconst finalTradeScore = Math.round(\n  0.4 * marketScore + 0.3 * complianceScore + 0.3 * (100 - riskScore)\n);\n\nlet recommendation = 'REVIEW';\nif (finalTradeScore >= 75) recommendation = 'PROCEED';\nelse if (finalTradeScore < 50) recommendation = 'AVOID';\n\nreturn [{ json: {\n  hs_code: hs.hs_code,\n  market_opportunity_score: marketScore,\n  top_counterparties: match.top_counterparties,\n  counterparty_risk_score: riskScore,\n  compliance_score: complianceScore,\n  final_trade_score: finalTradeScore,\n  recommendation,\n} }];"
      },
      "id": "8220be27-77b7-4568-9ea2-1f9b06620738",
      "name": "Code — Aggregate Trade Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        0
      ]
    },
