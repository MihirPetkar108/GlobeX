    {
      "parameters": {
        "jsCode": "const verified = $('HTTP — Document Verification (LLM)').first().json.extracted || {};\nconst onFile = $('Postgres — Fetch Trade Docs').first().json || {};\n\nconst mismatches = [];\nfor (const key of ['hs_code', 'quantity', 'value']) {\n  if (onFile[key] !== undefined && String(verified[key]) !== String(onFile[key])) {\n    mismatches.push({ field: key, document: verified[key], expected: onFile[key] });\n  }\n}\n\nreturn [{ json: {\n  trade_id: $('Edit Fields — Doc Meta').first().json.trade_id,\n  document_url: $('Edit Fields — Doc Meta').first().json.document_url,\n  extracted: verified,\n  inconsistency: mismatches.length > 0,\n  mismatches,\n} }];"
      },
      "id": "e8570b87-22ed-4116-b5ba-e923917b63ac",
      "name": "Code — Compare Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        544
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "inc",
              "leftValue": "={{ $json.inconsistency }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "6cf12cf3-ddf1-457b-89ef-abc9f2b1470f",
