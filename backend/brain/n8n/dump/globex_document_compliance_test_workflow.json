            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "versionId": "globex-doc-compliance-v1-0-0",
  "id": "globex-doc-compliance-test-workflow",
  "tags": ["globex", "sample-workflow-2", "document-compliance", "zero-db"]
