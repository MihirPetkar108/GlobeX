{
  "name": "GlobeXAI — Document & Compliance Screener (Zero-DB Test)",
  "nodes": [
    {
      "parameters": {
        "content": "## 📄 SAMPLE WORKFLOW 2: DOCUMENT & COMPLIANCE SCREENER (ZERO-DB)\n\n**PURPOSE:**\nVerify n8n document processing, bilateral tariff checking, and counterparty risk analysis with **Zero Database Dependency**.\n\n**TEST CHANNELS:**\n1. **Webhook:** Send POST to `http://localhost:5678/webhook/test-doc-compliance`\n2. **Manual Test:** Click orange 'Execute workflow' button below to run with pre-loaded invoice & shipping documents!",
        "height": 400,
        "width": 380,
        "color": 6
      },
      "id": "sticky-doc-note",
      "name": "README — Document Test",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-380, 200]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "test-doc-compliance",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-doc-intake",
      "name": "Webhook — Document Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [40, 320],
      "webhookId": "globex-doc-compliance-test-001"
    },

    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "document_url",
              "value": "={{ $json.body.document_url ?? $json.document_url ?? 'https://storage.globex.ai/docs/INV-2026-IND-UAE-550K.pdf' }}",
              "type": "string"
            },
            {
              "id": "d2",
              "name": "document_type",
              "value": "={{ $json.body.document_type ?? $json.document_type ?? 'COMMERCIAL_INVOICE' }}",
              "type": "string"
            },
            {
              "id": "d3",
              "name": "hs6",
              "value": "={{ Number($json.body.hs6 ?? $json.hs6 ?? 100630) }}",
              "type": "number"
            },
            {
              "id": "d4",
              "name": "origin_country",
              "value": "={{ $json.body.origin_country ?? $json.origin_country ?? 'IND' }}",
              "type": "string"
            },
            {
              "id": "d5",
              "name": "destination_country",
              "value": "={{ $json.body.destination_country ?? $json.destination_country ?? 'ARE' }}",
              "type": "string"
            },
            {
              "id": "d6",
              "name": "trade_value_usd",
              "value": "={{ Number($json.body.trade_value_usd ?? $json.trade_value_usd ?? 550000) }}",
              "type": "number"
            },
            {
              "id": "d7",
              "name": "organization_id",
              "value": "={{ $json.body.organization_id ?? $json.organization_id ?? 'ORG-IND-EXP-088' }}",
              "type": "string"
            },
            {
              "id": "d8",
              "name": "certifications",
              "value": "={{ $json.body.certifications ?? ['ISO 22000', 'APEDA', 'FSSAI', 'Halal'] }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "id": "set-doc-normalize",
      "name": "Set — Normalize Doc Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [260, 320]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/documents/ocr-extract",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"document_url\": $json.document_url, \"document_type\": $json.document_type, \"trade_id\": \"TRD-TEST-001\" }) }}",
        "options": {
          "timeout": 30000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "http-doc-ocr",
      "name": "HTTP — Document OCR Extraction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [480, 320]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/compliance/rag-analyze",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"hs6\": $('Set — Normalize Doc Payload').item.json.hs6, \"origin_country\": $('Set — Normalize Doc Payload').item.json.origin_country, \"destination_country\": $('Set — Normalize Doc Payload').item.json.destination_country, \"certifications\": $('Set — Normalize Doc Payload').item.json.certifications, \"trade_value_usd\": $('Set — Normalize Doc Payload').item.json.trade_value_usd }) }}",
        "options": {
          "timeout": 30000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "http-doc-compliance",
      "name": "HTTP — CEPA Compliance RAG",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [700, 320]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/predict/counterparty-risk",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ \"organization_id\": $('Set — Normalize Doc Payload').item.json.organization_id, \"hs6\": $('Set — Normalize Doc Payload').item.json.hs6 }) }}",
        "options": {
          "timeout": 30000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "http-doc-risk",
      "name": "HTTP — Counterparty Risk Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [920, 320]
    },

    {
      "parameters": {
        "jsCode": "// Synthesize Document Verification & Compliance Audit\nconst docInput = $('Set — Normalize Doc Payload').first().json;\nconst ocr = $('HTTP — Document OCR Extraction').first().json;\nconst comp = $('HTTP — CEPA Compliance RAG').first().json;\nconst risk = $('HTTP — Counterparty Risk Audit').first().json;\n\nconst compScore = Number(comp?.compliance_score ?? 90);\nconst riskComposite = Number(risk?.risk?.composite_score ?? 0.88);\nconst dutySaved = Number(comp?.tariff?.duty_savings_usd ?? 27500);\n\nconst auditPassed = compScore >= 70 && risk?.risk?.risk_level !== 'HIGH';\n\nreturn [{\n  json: {\n    status: 'VERIFIED',\n    workflow_name: 'Document & Compliance Verification Audit',\n    verification_id: `VER-${Date.now().toString(36).toUpperCase()}`,\n    document_audited: {\n      url: docInput.document_url,\n      type: docInput.document_type,\n      ocr_pipeline_status: ocr?.status ?? 'STUB_VERIFIED'\n    },\n    trade_corridor: `${docInput.origin_country} ➔ ${docInput.destination_country}`,\n    regulatory_framework: {\n      agreement: comp?.tariff?.agreement ?? 'India-UAE CEPA',\n      preferential_duty: `${comp?.tariff?.preferential_rate_pct ?? 0}%`,\n      standard_mfn: `${comp?.tariff?.standard_mfn_rate_pct ?? 5}%`,\n      net_duty_savings_usd: dutySaved,\n      mandatory_documents: comp?.required_documents ?? []\n    },\n    counterparty_profile: {\n      org_id: docInput.organization_id,\n      trust_score: risk?.risk?.trust_score ?? 94,\n      risk_level: risk?.risk?.risk_level ?? 'LOW',\n      dispute_rate: `${((risk?.risk?.dispute_rate ?? 0.01) * 100).toFixed(1)}%`\n    },\n    compliance_score: compScore,\n    audit_verdict: auditPassed ? 'CLEARED_FOR_SHIPMENT' : 'HOLD_MANUAL_REVIEW',\n    n8n_test_passed: true,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-doc-synthesize",
      "name": "Code — Synthesize Audit Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 320]
    },

    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Code — Synthesize Audit Verdict').item.json) }}",
        "options": {}
      },
      "id": "respond-doc-output",
      "name": "Respond — Audit Verdict JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1360, 320]
    }
  ],
  "pinData": {},
