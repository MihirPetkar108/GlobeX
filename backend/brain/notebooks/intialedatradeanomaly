    "# ================= FEATURE SELECTION =================\n",
    "\n",
    "from sklearn.feature_selection import chi2\n",
    "import pandas as pd\n",
    "\n",
    "# Target\n",
    "target = \"anomaly_flag\"\n",
    "y = df[target]\n",
    "\n",
    "# ---------- 1. SPEARMAN CORRELATION ----------\n",
    "# Exclude target and anomaly_type columns to avoid target leakage\n",
    "numeric_cols = [\n",
    "    col for col in df.select_dtypes(include=[\"int64\", \"float64\"]).columns\n",
    "    if col != target and not col.startswith(\"anomaly_type_\")\n",
    "]\n",
    "\n",
    "spearman_corr = df[numeric_cols + [target]].corr(method=\"spearman\")[target].drop(target)\n",
    "\n",
    "spearman_results = pd.DataFrame({\n",
    "    \"Feature\": spearman_corr.index,\n",
    "    \"Spearman_Correlation\": spearman_corr.values,\n",
    "    \"Absolute_Correlation\": spearman_corr.abs().values\n",
    "}).sort_values(\"Absolute_Correlation\", ascending=False)\n",
    "\n",
    "print(\"===== SPEARMAN CORRELATION =====\")\n",
    "print(spearman_results)\n",
    "\n",
    "\n",
    "# ---------- 2. CHI-SQUARE TEST ----------\n",
    "# Binary/categorical encoded features\n",
    "categorical_cols = [\n",
    "    col for col in df.columns\n",
    "    if (\n",
    "        col.startswith(\"hs6_\")\n",
    "        or col.startswith(\"partner_iso3_\")\n",
    "        or col == \"trade_flow\"\n",
    "        or col == \"new_corridor_flag\"\n",
    "    )\n",
    "]\n",
    "\n",
    "X_cat = df[categorical_cols]\n",
    "\n",
    "chi2_scores, p_values = chi2(X_cat, y)\n",
    "\n",
    "chi2_results = pd.DataFrame({\n",
    "    \"Feature\": categorical_cols,\n",
    "    \"Chi2\": chi2_scores,\n",
    "    \"p_value\": p_values\n",
    "}).sort_values(\"p_value\")\n",
    "\n",
    "# Hypothesis testing\n",
    "alpha = 0.05\n",
    "\n",
    "chi2_results[\"Decision\"] = chi2_results[\"p_value\"].apply(\n",
    "    lambda p: \"Reject H0\" if p < alpha else \"Fail to Reject H0\"\n",
    ")\n",
    "\n",
    "print(\"\\n===== CHI-SQUARE TEST =====\")\n",
    "print(chi2_results)\n",
    "\n",
    "# Significant features\n",
    "significant_features = chi2_results[chi2_results[\"p_value\"] < alpha]\n",
    "\n",
    "print(\"\\n===== SIGNIFICANT FEATURES (p < 0.05) =====\")\n",
    "print(significant_features)"
   ]
