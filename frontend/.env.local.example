# GlobeX Express API
VITE_API_URL=http://localhost:5002
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/globex-analyze-trade
VITE_N8N_TEST_WEBHOOK_URL=http://localhost:5678/webhook/globex-test-trade

# Optional direct n8n webhook base. Keep empty until workflow phase.
# VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook

# Frontend auth
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional data providers
# OPENSANCTIONS_API_KEY=your-opensanctions-api-key-here
# GLOBEX_COMTRADE_API_URL=https://comtradeapi.un.org/data/v1/get
# COMTRADE_SUBSCRIPTION_KEY=your-comtrade-api-key-here

# Blockchain is reached by Express through CHAIN_ADAPTER_URL.
# Private key and RPC stay in chain adapter process.
# CHAIN_ADAPTER_URL=http://127.0.0.1:3001
