# ==============================================================================
# GlobeXAI Trade OS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and configure your environment.

# ------------------------------------------------------------------------------
# 1. FastAPI AI/ML Microservice Gateway
# ------------------------------------------------------------------------------
# Base URL for the unified FastAPI backend (main:app).
# Default local development port is 8000.
VITE_FASTAPI_AI_URL=http://localhost:8000
PORT=8000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. n8n Workflow Automation Engine
# ------------------------------------------------------------------------------
# Base URL for the n8n webhook listener.
# Standard local n8n container listens on port 5678.
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook
GLOBEX_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. Database & Persistence (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string or URL for live Supabase PostgreSQL instance.
# When omitted, services fall back to deterministic seed data.
# SUPABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# SUPABASE_KEY=your-supabase-service-role-key-here
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 4. External Intelligence & Sanctions APIs
# ------------------------------------------------------------------------------
OPENSANCTIONS_API_KEY=your-opensanctions-api-key-here

# UN Comtrade API Subscription Key (for Section 5 data ingestion workflow)
# GLOBEX_COMTRADE_API_URL=https://comtradeapi.un.org/data/v1/get
# COMTRADE_SUBSCRIPTION_KEY=your-comtrade-api-key

# World Bank WITS API
# GLOBEX_WITS_API_URL=https://wits.worldbank.org/API/V1/SDMX/V21/rest/data

# ------------------------------------------------------------------------------
# 5. Blockchain & Escrow (Testnet)
# ------------------------------------------------------------------------------
# EVM Testnet RPC (Sepolia / Arbitrum Sepolia / Polygon Amoy)
# GLOBEX_BLOCKCHAIN_SERVICE_URL=https://rpc.sepolia.org
# ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ------------------------------------------------------------------------------
# 6. Logistics & Shipment Tracking
# ------------------------------------------------------------------------------
# GLOBEX_TRACKING_API_URL=https://api.aftership.com/v4
# GLOBEX_TRACKING_API_KEY=your-tracking-key-here

# ------------------------------------------------------------------------------
# 7. Document OCR & Vision Service
# ------------------------------------------------------------------------------
# VITE_OCR_SERVICE_URL=http://localhost:8000/documents/ocr-extract
